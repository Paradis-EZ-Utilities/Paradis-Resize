<Window x:Class="ParadisResize.UI.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paradis Resize" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Background}" FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="22,18,22,18">
    <TextBlock x:Name="HeadingText" Text="Finished" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="CountText" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />

    <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="8" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Original size" Style="{StaticResource FormLabel}" FontSize="13" />
        <TextBlock x:Name="OriginalSizeText" Grid.Column="1" HorizontalAlignment="Right" FontSize="13" />
        <TextBlock Grid.Row="1" Text="New size" Style="{StaticResource FormLabel}" FontSize="13" Margin="0,6,0,0" />
        <TextBlock x:Name="NewSizeText" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" FontSize="13" Margin="0,6,0,0" />
        <TextBlock x:Name="SavedLabel" Grid.Row="2" Text="Space saved" Style="{StaticResource FormLabel}" FontSize="13" Margin="0,6,0,0" />
        <TextBlock x:Name="SavedText" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource Success}" Margin="0,6,0,0" />
      </Grid>
    </Border>

    <TextBlock x:Name="ProblemsText" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Warning}"
               Visibility="Collapsed" />
    <TextBlock x:Name="WhereText" Style="{StaticResource Caption}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
    <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
               Text="Your original images were not changed. Compare the new copies before deleting anything." />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="OpenFolderButton" Style="{StaticResource FlatButton}" Content="Open Output Folder" Margin="0,0,8,0"
              Click="OnOpenFolder" />
      <Button Style="{StaticResource PrimaryButton}" Content="Done" Padding="22,8" FontSize="13" IsDefault="True" IsCancel="True"
              Click="OnDone" />
    </StackPanel>
  </StackPanel>
</Window>
