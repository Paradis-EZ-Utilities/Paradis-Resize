<Window x:Class="ParadisResize.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadisResize.UI"
        Title="Paradis Resize" Width="880" Height="720" MinWidth="700" MinHeight="600"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI"
        AllowDrop="True" PreviewDragEnter="OnPreviewDragOver" PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave" PreviewDrop="OnPreviewDrop" Closing="OnClosing">
  <!-- The whole workflow on one screen: drop images, choose Resize or Optimize, adjust one or two
       settings, press the big button. No tabs, no advanced panel. -->
  <Grid Margin="18,12,18,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="150" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <local:Wordmark Height="22" HorizontalAlignment="Left" />
      <TextBlock Grid.Column="1" Text="Make big images smaller" Style="{StaticResource Caption}"
                 HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,2,0,0" />
    </Grid>

    <!-- Input: a big drop area until images are added, then the list. The whole window accepts drops. -->
    <Grid Grid.Row="1">
      <Border x:Name="EmptyPanel" Style="{StaticResource DropZone}">
        <Grid>
          <Rectangle x:Name="DropOutline" RadiusX="10" RadiusY="10" Stroke="{StaticResource Border}" StrokeThickness="1.5"
                     StrokeDashArray="5 4" Margin="8" SnapsToDevicePixels="True" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <!-- A picture with an arrow into it, drawn so it needs no image file. -->
            <Viewbox Width="54" Height="54" HorizontalAlignment="Center">
              <Canvas Width="48" Height="48">
                <Path Data="M 8 18 L 8 40 L 40 40 L 40 18" Stroke="{StaticResource TextDim}" StrokeThickness="2.5"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 24 4 L 24 28 M 15 19 L 24 28 L 33 19" Stroke="{StaticResource Accent}" StrokeThickness="3"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Drop images or folders here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Margin="0,12,0,0" />
            <TextBlock Text="PNG, JPEG and WebP · your originals are never changed" Style="{StaticResource Caption}"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
              <Button Style="{StaticResource FlatButton}" Content="Add Files…" Click="OnAddFiles" Margin="0,0,8,0" />
              <Button Style="{StaticResource FlatButton}" Content="Add Folder…" Click="OnAddFolder" />
            </StackPanel>
            <CheckBox x:Name="SubfoldersCheckEmpty" Style="{StaticResource DarkCheckBox}" Content="Include subfolders"
                      HorizontalAlignment="Center" Margin="0,12,0,0" Checked="OnSubfoldersChanged" Unchecked="OnSubfoldersChanged"
                      ToolTip="When you add a folder, also add images from the folders inside it" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="QueuePanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListView x:Name="QueueList" Style="{StaticResource QueueList}" ItemContainerStyle="{StaticResource QueueRow}"
                  SelectionMode="Extended" SizeChanged="OnQueueSizeChanged" KeyDown="OnQueueKeyDown"
                  SelectionChanged="OnQueueSelectionChanged" MouseDoubleClick="OnQueueDoubleClick"
                  AutomationProperties.Name="Images">
          <ListView.ContextMenu>
            <ContextMenu Opened="OnQueueMenuOpened">
              <MenuItem x:Name="ShowNewMenu" Header="Show new file in folder" Click="OnShowNewFile" />
              <MenuItem x:Name="ShowOriginalMenu" Header="Show original in folder" Click="OnShowOriginal" />
              <MenuItem x:Name="RemoveMenu" Header="Remove from list" InputGestureText="Del" Click="OnRemoveSelected" />
            </ContextMenu>
          </ListView.ContextMenu>
          <ListView.View>
            <GridView ColumnHeaderContainerStyle="{StaticResource QueueHeader}" AllowsColumnReorder="False">
              <GridViewColumn x:Name="NameColumn" Header="Image" Width="230">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Cell}" ToolTip="{Binding ToolTipText}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Format" Width="58">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding FormatText}" Style="{StaticResource DimCell}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Dimensions" Width="168">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource DimCell}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="File size" Width="150">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource DimCell}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Saved" Width="64">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding SavedText}" Style="{StaticResource Cell}" Foreground="{StaticResource Success}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn x:Name="StatusColumn" Header="Status" Width="150">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock x:Name="StatusCell" Text="{Binding StatusText}" Style="{StaticResource Cell}" ToolTip="{Binding ToolTipText}" />
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                        <Setter TargetName="StatusCell" Property="Foreground" Value="{StaticResource Success}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StatusKind}" Value="muted">
                        <Setter TargetName="StatusCell" Property="Foreground" Value="{StaticResource TextDim}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                        <Setter TargetName="StatusCell" Property="Foreground" Value="{StaticResource Warning}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StatusKind}" Value="error">
                        <Setter TargetName="StatusCell" Property="Foreground" Value="{StaticResource Danger}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StatusKind}" Value="busy">
                        <Setter TargetName="StatusCell" Property="Foreground" Value="{StaticResource Accent}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>

        <!-- List toolbar -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="AddFilesButton" Style="{StaticResource FlatButton}" Content="Add Files…" Padding="12,5" Click="OnAddFiles" />
          <Button x:Name="AddFolderButton" Grid.Column="1" Style="{StaticResource FlatButton}" Content="Add Folder…" Padding="12,5"
                  Margin="8,0,0,0" Click="OnAddFolder" />
          <CheckBox x:Name="SubfoldersCheck" Grid.Column="2" Style="{StaticResource DarkCheckBox}" Content="Include subfolders"
                    VerticalAlignment="Center" Margin="14,0,0,0" Checked="OnSubfoldersChanged" Unchecked="OnSubfoldersChanged"
                    ToolTip="When you add a folder, also add images from the folders inside it" />
          <TextBlock x:Name="QueueSummaryText" Grid.Column="3" Style="{StaticResource Caption}" FontSize="12"
                     VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,12,0" TextTrimming="CharacterEllipsis" />
          <Button x:Name="RemoveButton" Grid.Column="4" Style="{StaticResource FlatButton}" Content="Remove" Padding="12,5"
                  Click="OnRemoveSelected" IsEnabled="False" ToolTip="Remove the selected images from the list (the files aren't touched)" />
          <Button x:Name="ClearButton" Grid.Column="5" Style="{StaticResource FlatButton}" Content="Clear List" Padding="12,5"
                  Margin="8,0,0,0" Click="OnClearList" ToolTip="Empty the list (the files aren't touched)" />
        </Grid>
      </Grid>

      <!-- Shown while files are dragged over the window. -->
      <Border x:Name="DragOverlay" Visibility="Collapsed" CornerRadius="10" Background="#CC1E1F22"
              BorderBrush="{StaticResource Accent}" BorderThickness="2" IsHitTestVisible="False">
        <TextBlock Text="Drop to add images" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
    </Grid>

    <!-- Settings -->
    <Border x:Name="SettingsPanel" Grid.Row="2" Margin="0,10,0,0" Padding="14,10" CornerRadius="8"
            Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="86" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Mode -->
        <TextBlock Text="I want to" Style="{StaticResource FormLabel}" />
        <UniformGrid Grid.Column="1" Columns="2">
          <RadioButton x:Name="ResizeModeRadio" GroupName="Mode" Style="{StaticResource SegmentButton}" Margin="0,0,3,0"
                       Checked="OnSettingChanged" Content="Resize images"
                       ToolTip="Change the width and height in pixels" />
          <RadioButton x:Name="OptimizeModeRadio" GroupName="Mode" Style="{StaticResource SegmentButton}" Margin="3,0,0,0"
                       Checked="OnSettingChanged" Content="Optimize images"
                       ToolTip="Keep the width and height; make the files smaller" />
        </UniformGrid>

        <!-- Resize settings -->
        <Grid x:Name="ResizePanel" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="New size" Style="{StaticResource FormLabel}" />
          <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="ByDimensionsRadio" GroupName="ResizeBy" Style="{StaticResource DotRadio}" Content="Width / Height"
                         Checked="OnSettingChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
            <!-- Width and height boxes; an empty box means Auto. -->
            <StackPanel x:Name="DimensionsInputs" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
              <Grid Width="78">
                <TextBox x:Name="WidthBox" Style="{StaticResource TextBoxStyle}" Padding="7,4" TextChanged="OnSettingChanged"
                         AutomationProperties.Name="Width in pixels" ToolTip="Width in pixels. Leave empty for Auto." MaxLength="6"
                         PreviewTextInput="OnDigitsOnly" GotFocus="OnDimensionBoxFocus" />
                <TextBlock x:Name="WidthPlaceholder" Text="Auto" Style="{StaticResource Caption}" FontSize="13" Margin="9,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
              </Grid>
              <TextBlock Text="×" Margin="7,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />
              <Grid Width="78">
                <TextBox x:Name="HeightBox" Style="{StaticResource TextBoxStyle}" Padding="7,4" TextChanged="OnSettingChanged"
                         AutomationProperties.Name="Height in pixels" ToolTip="Height in pixels. Leave empty for Auto." MaxLength="6"
                         PreviewTextInput="OnDigitsOnly" GotFocus="OnDimensionBoxFocus" />
                <TextBlock x:Name="HeightPlaceholder" Text="Auto" Style="{StaticResource Caption}" FontSize="13" Margin="9,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
              </Grid>
              <TextBlock Text="pixels" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />
            </StackPanel>
            <RadioButton x:Name="ByPercentRadio" GroupName="ResizeBy" Style="{StaticResource DotRadio}" Content="Percentage"
                         Checked="OnSettingChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel x:Name="PercentInputs" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="PercentBox" Style="{StaticResource TextBoxStyle}" Width="58" Padding="7,4" TextChanged="OnSettingChanged"
                       AutomationProperties.Name="Percentage" MaxLength="4" PreviewTextInput="OnDigitsOnly"
                       GotFocus="OnPercentBoxFocus" ToolTip="50 makes the width and height half as big" />
              <TextBlock Text="%" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />
            </StackPanel>
          </WrapPanel>

          <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,9,0,0">
            <CheckBox x:Name="KeepProportionsCheck" Style="{StaticResource DarkCheckBox}" Content="Keep proportions" Margin="0,0,22,0"
                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                      ToolTip="Pictures keep their shape. With both width and height filled in, each image is made to fit inside that size." />
            <CheckBox x:Name="DontEnlargeCheck" Style="{StaticResource DarkCheckBox}" Content="Don't enlarge smaller images"
                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                      ToolTip="Images that are already smaller than the new size are copied unchanged instead of being stretched" />
          </WrapPanel>

          <TextBlock x:Name="ResizeHintText" Grid.Row="2" Grid.Column="1" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                     Style="{StaticResource Caption}" />
        </Grid>

        <!-- Optimize settings -->
        <Grid x:Name="OptimizePanel" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="1">
            <TextBlock Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"
                       Text="Makes the files smaller while keeping the same width, height and look. If an image is already stored efficiently, it is copied unchanged." />
            <CheckBox x:Name="ConversionCheck" Style="{StaticResource DarkCheckBox}" Margin="0,9,0,0"
                      Content="Allow format conversion for smaller files" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
            <TextBlock x:Name="ConversionHint" Style="{StaticResource Caption}" FontSize="12" Margin="27,3,0,0" TextWrapping="Wrap"
                       Text="A PNG photo with no transparency may be saved as a much smaller JPEG. Images with transparency, screenshots and drawings stay PNG." />
          </StackPanel>
        </Grid>

        <!-- Save as -->
        <TextBlock Grid.Row="2" Text="Save as" Style="{StaticResource FormLabel}" Margin="0,10,0,0" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
          <ComboBox x:Name="FormatCombo" Width="200" SelectionChanged="OnSettingChanged" AutomationProperties.Name="Save as">
            <ComboBoxItem Content="Same format as original" />
            <ComboBoxItem Content="PNG" />
            <ComboBoxItem Content="JPEG" />
            <ComboBoxItem Content="WebP" />
          </ComboBox>
          <TextBlock x:Name="FormatHintText" Style="{StaticResource Caption}" FontSize="12" Margin="12,0,0,0"
                     VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
        </StackPanel>

        <!-- Save to -->
        <TextBlock Grid.Row="3" Text="Save to" Style="{StaticResource FormLabel}" Margin="0,10,0,0" />
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"
                     Foreground="{StaticResource TextDim}" />
          <Button x:Name="DefaultFolderButton" Grid.Column="1" Style="{StaticResource LinkButton}" FontSize="12"
                  Content="Use default" Margin="10,0,0,0" VerticalAlignment="Center" Click="OnDefaultFolder" Visibility="Collapsed" />
          <Button x:Name="ChooseFolderButton" Grid.Column="2" Style="{StaticResource FlatButton}" Content="Choose Folder…"
                  Margin="10,0,0,0" Padding="10,4" Click="OnChooseFolder" AutomationProperties.Name="Choose output folder" />
        </Grid>
      </Grid>
    </Border>

    <!-- Action: the big button, or progress while working. -->
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Padding="18,10"
              HorizontalContentAlignment="Center" Click="OnStart" Content="RESIZE" IsEnabled="False" />
      <Border x:Name="ProgressPanel" Visibility="Collapsed" Padding="12,8" CornerRadius="6"
              Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ProgressTitleText" FontWeight="SemiBold" Text="Getting ready…" />
              <TextBlock x:Name="ProgressFileText" Grid.Column="1" Style="{StaticResource Caption}" FontSize="12" Margin="10,1,0,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <ProgressBar x:Name="BatchProgressBar" Minimum="0" Maximum="1" Margin="0,6,0,0" AutomationProperties.Name="Progress" />
            <TextBlock x:Name="ProgressCountsText" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource FlatButton}" Content="Cancel"
                  Padding="14,6" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnCancel"
                  ToolTip="Stop after the current image. Finished images are kept; originals are never touched." />
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource LinkButton}" Content="About" Click="OnAbout" />
      <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Log folder" Margin="14,0,0,0" Click="OnOpenLogs" />
      <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="More from Paradis EZ Utilities" Margin="14,0,0,0"
              Click="OnMoreLink" ToolTip="https://github.com/Paradis-EZ-Utilities" />
      <TextBlock x:Name="VersionFooterText" Grid.Column="3" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                 VerticalAlignment="Center" Opacity="0.8" />
    </Grid>
  </Grid>
</Window>
