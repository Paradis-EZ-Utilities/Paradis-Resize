<?xml version="1.0" encoding="utf-8"?>
<!-- The release build: one self-contained ParadisResize.exe (plus libvips-42.dll beside it) for 64-bit Windows 10/11, no .NET install needed.
     dotnet publish src/ParadisResize -p:PublishProfile=win-x64-self-contained   -> publish/win-x64/ -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
